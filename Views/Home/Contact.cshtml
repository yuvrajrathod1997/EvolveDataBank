@{
    ViewData["Title"] = "Contact Us | Evolve DataBank";
    ViewData["Description"] = "Contact Evolve DataBank for a report enquiry, a free sample, or a general question.";
}

<div class="page-banner">
    <div class="wrap">
        <h1>Contact us</h1>
        <p>Send an enquiry or ask for a free sample. We reply by email.</p>
    </div>
</div>

<section class="section">
    <div class="wrap split">
        <div>
            <h2>Get in touch</h2>
            <ul class="contact-list">
                <li><strong>Address</strong><a href="https://maps.app.goo.gl/tc3tUN7BNgZf8KQd8">M/S Evolve Business Intelligence, C-218, 2nd floor, M-Cube, N.H. 48, Balitha, Vapi, Valsad, Gujarat</a></li>
                <li><strong>Call us</strong><a href="tel:+916353963987">+91 6353963987</a></li>
                <li><strong>Mail us</strong><a href="mailto:info@@evolvebi.com">info&#64;evolvebi.com</a><br><a href="mailto:sales@@evolvebi.com">sales&#64;evolvebi.com</a></li>
            </ul>
        </div>

        @* The form is sent by wwwroot/js/main.js as an email (mailto). Replace with a POST action when a mail service is available. *@
        <form id="enquiry-form" action="mailto:sales@@evolvebi.com">
            <h2>Send an enquiry</h2>
            <div class="form-grid">
                <fieldset class="full">
                    <legend>What do you need?</legend>
                    <div class="radio-row">
                        <label><input type="radio" name="type" value="Enquiry" checked> Report enquiry</label>
                        <label><input type="radio" name="type" value="Free sample"> Free sample</label>
                        <label><input type="radio" name="type" value="General question"> General question</label>
                    </div>
                </fieldset>
                <div><label for="name">Full name</label><input id="name" name="name" type="text" required autocomplete="name"></div>
                <div><label for="email">Work email</label><input id="email" name="email" type="email" required autocomplete="email"></div>
                <div><label for="company">Company</label><input id="company" name="company" type="text" autocomplete="organization"></div>
                <div><label for="country">Country</label><input id="country" name="country" type="text" autocomplete="country-name"></div>
                <div class="full">
                    <label for="report">Report</label>
                    <select id="report" name="report">
                        <option value="">Not about a specific report</option>
                        @foreach (var r in Store.Reports)
                        {
                            <option value="@r.Slug">@r.Title</option>
                        }
                    </select>
                </div>
                <div class="full"><label for="message">Message</label><textarea id="message" name="message"></textarea></div>
                <div class="full"><button class="btn" type="submit">Send enquiry</button></div>
            </div>
            <p class="form-note">This opens your email app with the enquiry filled in.</p>
        </form>
    </div>
</section>
